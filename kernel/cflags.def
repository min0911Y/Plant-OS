# Shared compiler flags for kernel C/C++ builds.
KERNEL_UBSAN_FLAGS =
KERNEL_KASAN_FLAGS =
KERNEL_FRAME_POINTER_FLAGS = -fomit-frame-pointer
KERNEL_PERF_ENABLED := $(if $(filter 1,$(PERF)),1,0)
KERNEL_KASAN_ENABLED := $(if $(filter 1,$(KASAN)),1,0)
KERNEL_BENCH_ENABLED := $(if $(filter 1,$(BENCH)),1,0)
KERNEL_MEMTEST_ENABLED := $(if $(filter 0,$(MEMTEST)),0,1)
KERNEL_PERF_STACKS := $(if $(PERF_STACKS),$(PERF_STACKS),4096)
ARCH ?= i386
PLATFORM ?= pc
KERNEL_CFLAGS_FILE := $(abspath $(lastword $(MAKEFILE_LIST)))
KERNEL_BUILD_FILES := $(KERNEL_CFLAGS_FILE) $(dir $(KERNEL_CFLAGS_FILE))cdef.mk
KERNEL_CONFIG_STAMP := $(dir $(KERNEL_CFLAGS_FILE))obj/.build-config
KERNEL_BUILD_CONFIG := \
	ARCH=$(ARCH) PLATFORM=$(PLATFORM) PERF=$(KERNEL_PERF_ENABLED) KASAN=$(KERNEL_KASAN_ENABLED) \
	BENCH=$(KERNEL_BENCH_ENABLED) MEMTEST=$(KERNEL_MEMTEST_ENABLED) \
	MEMSIZE_MB=$(if $(filter 0,$(KERNEL_MEMTEST_ENABLED)),$(MEMSIZE_MB),) \
	PERF_STACKS=$(if $(filter 1,$(KERNEL_PERF_ENABLED)),$(KERNEL_PERF_STACKS),)

.PHONY: kernel_config_force
kernel_config_force:

$(KERNEL_CONFIG_STAMP): kernel_config_force
	@mkdir -p $(dir $@)
	@temporary="$@.$$$$"; \
	printf '%s\n' '$(KERNEL_BUILD_CONFIG)' > "$$temporary"; \
	if ! cmp -s "$$temporary" "$@"; then \
		mv "$$temporary" "$@"; \
	else \
		rm -f "$$temporary"; \
	fi

ifeq ($(KASAN),1)
KERNEL_KASAN_FLAGS = -DKERNEL_KASAN -fsanitize=kernel-address
endif

ifeq ($(PERF),1)
CDEFS += -DKERNEL_PERF -DKERNEL_PERF_STACK_CAPACITY=$(KERNEL_PERF_STACKS)
KERNEL_FRAME_POINTER_FLAGS = -fno-omit-frame-pointer -fno-optimize-sibling-calls
endif

ifeq ($(BENCH),1)
CDEFS += -DKERNEL_ENABLE_BOOT_BENCH
endif

ifeq ($(MEMTEST),0)
ifeq ($(MEMSIZE_MB),)
$(error MEMTEST=0 requires MEMSIZE_MB=<megabytes>)
endif
CDEFS += -DKERNEL_DISABLE_MEMTEST -DKERNEL_MEMSIZE_MB=$(MEMSIZE_MB)
endif

ifeq ($(ARCH),i386)
KERNEL_ARCH_CFLAGS = -m32 -mno-mmx -mno-sse -mfpmath=387
KERNEL_ARCH_LD_EMULATION = elf_i386
KERNEL_ARCH_ASM_FORMAT = elf32
CDEFS += -DKERNEL_ARCH_I386
else
$(error unsupported ARCH '$(ARCH)'; supported architectures: i386)
endif

KERNEL_COMMON_CFLAGS = \
	$(KERNEL_ARCH_CFLAGS) -I$(incpath_src) -nostdinc -nolibc -nostdlib -fno-builtin \
	-ffreestanding -fno-stack-protector -Qn -fno-pic -fno-pie \
	-fno-asynchronous-unwind-tables -MMD -MP $(KERNEL_FRAME_POINTER_FLAGS) \
	-finput-charset=UTF-8 -fexec-charset=GB2312 \
	$(KERNEL_UBSAN_FLAGS) $(KERNEL_KASAN_FLAGS) $(CDEFS)

KERNEL_NOKASAN_CFLAGS = \
	$(filter-out -fsanitize=kernel-address,$(KERNEL_COMMON_CFLAGS)) \
	-fno-sanitize=kernel-address

KERNEL_COMMON_CXXFLAGS = \
	$(KERNEL_COMMON_CFLAGS) \
	-fno-use-cxa-atexit -fno-exceptions -fno-rtti

KERNEL_PACKED_BITFIELD_FLAGS = -Wno-packed-bitfield-compat

kernel_depfiles = \
	$(eval $(filter %.o %.obj,$1): $(KERNEL_CONFIG_STAMP) $(KERNEL_BUILD_FILES)) \
	$(patsubst %.o,%.d,$(filter %.o,$1))
