--- /dev/null
+++ b/modules/lwjgl/core/src/main/java/org/lwjgl/system/plantos/PlantOSLibrary.java
@@ -0,0 +1,64 @@
+/*
+ * Copyright LWJGL. All rights reserved.
+ * License terms: https://www.lwjgl.org/license
+ */
+package org.lwjgl.system.plantos;
+
+import org.jspecify.annotations.*;
+import org.lwjgl.system.*;
+
+import java.nio.*;
+
+import static org.lwjgl.system.MemoryStack.*;
+import static org.lwjgl.system.MemoryUtil.*;
+
+/** Implements a {@link SharedLibrary} using the Plant OS ELF loader. */
+public final class PlantOSLibrary extends SharedLibrary.Default {
+
+    private static final int RTLD_LAZY = 1;
+    private static final int RTLD_LOCAL = 0;
+
+    public PlantOSLibrary(String name) {
+        this(name, loadLibrary(name));
+    }
+
+    public PlantOSLibrary(String name, long handle) {
+        super(name, handle);
+    }
+
+    private static long loadLibrary(String name) {
+        long handle;
+        try (MemoryStack stack = stackPush()) {
+            handle = ndlopen(memAddress(stack.UTF8(name)), RTLD_LAZY | RTLD_LOCAL);
+        }
+        if (handle == NULL) {
+            long error = ndlerror();
+            throw new UnsatisfiedLinkError(
+                "Failed to dynamically load library: " + name +
+                (error == NULL ? "" : " (error = " + memUTF8Safe(error) + ")")
+            );
+        }
+        return handle;
+    }
+
+    @Override
+    public @Nullable String getPath() {
+        return SharedLibraryUtil.getLibraryPath(address());
+    }
+
+    @Override
+    public long getFunctionAddress(ByteBuffer functionName) {
+        return ndlsym(address(), memAddress(functionName));
+    }
+
+    @Override
+    public void free() {
+        ndlclose(address());
+    }
+
+    private static native long ndlopen(long filename, int mode);
+    private static native long ndlerror();
+    private static native long ndlsym(long handle, long name);
+    private static native int ndlclose(long handle);
+
+}
