+  (void)env;
+  (void)jpid;
+  (void)jarray;
+  (void)jparentArray;
+  (void)jstimesArray;
+  return 0;
+}
+
+pid_t os_getParentPidAndTimings(JNIEnv *env, pid_t pid, jlong *totalTime,
+                                jlong *startTime) {
+  (void)env;
+  if (pid != getpid()) {
+    return -1;
+  }
+  if (totalTime != NULL) {
+    *totalTime = 0;
+  }
+  if (startTime != NULL) {
+    *startTime = 0;
+  }
+  return getppid();
+}
