+bool CodeHeap::make_executable(CodeBlob* blob) {
+#if defined(__plantos__)
+  if (blob == NULL || !contains_blob(blob)) {
+    return false;
+  }
+  char* begin = (char*)blob->content_begin();
+  char* end = (char*)blob->content_end();
+  if (begin >= end) {
+    return true;
+  }
+  const size_t page_size = (size_t)os::vm_page_size();
+  assert(((uintptr_t)begin & (page_size - 1)) == 0,
+         "code content must start at a page boundary");
+  assert(((uintptr_t)end & (page_size - 1)) == 0,
+         "code content must end at a page boundary");
+  return os::protect_memory(begin, end - begin, os::MEM_PROT_RX);
+#else
+  (void)blob;
+  return true;
+#endif
+}
+
+bool CodeHeap::make_writable(void* p) {
+#if defined(__plantos__)
+  HeapBlock* block = (HeapBlock*)find_block_for(p);
+  if (block == NULL || block->free()) {
+    return false;
+  }
+  return os::protect_memory((char*)block, segments_to_size(block->length()),
+                            os::MEM_PROT_RW);
+#else
+  (void)p;
+  return true;
+#endif
+}
 
