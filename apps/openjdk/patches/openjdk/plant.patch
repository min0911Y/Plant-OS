+++ b/src/java.base/bsd/native/libnet/bsd_close.c
@@ -0,0 +1,111 @@
+#if defined(__plantos__)
+
+#include <errno.h>
+#include <poll.h>
+#include <socket.h>
+
+#include "jni.h"
+#include "net_util_md.h"
+
+static int plant_socket_result(int result) {
+  if (result >= 0) {
+    return result;
+  }
+  switch (result) {
+  case SOCKET_ERR_INVAL:
+    errno = EINVAL;
+    break;
+  case SOCKET_ERR_NOMEM:
+    errno = ENOMEM;
+    break;
+  case SOCKET_ERR_NOENT:
+    errno = EBADF;
+    break;
+  case SOCKET_ERR_AGAIN:
+    errno = EAGAIN;
+    break;
+  case SOCKET_ERR_NOTCONN:
+    errno = ENOTCONN;
+    break;
+  case SOCKET_ERR_TIMEDOUT:
+    errno = ETIMEDOUT;
+    break;
+  case SOCKET_ERR_NETDOWN:
+    errno = ENETDOWN;
+    break;
+  case SOCKET_ERR_ADDRINUSE:
+    errno = EADDRINUSE;
+    break;
+  case SOCKET_ERR_BUSY:
+    errno = EBUSY;
+    break;
+  case SOCKET_ERR_PROTOCOL:
+    errno = EPROTONOSUPPORT;
+    break;
+  default:
+    errno = EIO;
+    break;
+  }
+  return -1;
+}
+
+int NET_Dup2(int oldfd, int newfd) {
+  (void)oldfd;
+  (void)newfd;
+  errno = ENOSYS;
+  return -1;
+}
+
+int NET_SocketClose(int fd) { return plant_socket_result(socket_close(fd)); }
+
+int NET_Read(int fd, void *buffer, size_t length) {
+  return plant_socket_result(recv(fd, buffer, (uint32_t)length, 0));
+}
+
+int NET_NonBlockingRead(int fd, void *buffer, size_t length) {
+  return plant_socket_result(
+      recv(fd, buffer, (uint32_t)length, MSG_DONTWAIT));
+}
+
+int NET_RecvFrom(int fd, void *buffer, int length, unsigned int flags,
+                 struct sockaddr *from, socklen_t *fromlen) {
+  return plant_socket_result(
+      recvfrom(fd, buffer, (uint32_t)length, flags, from, fromlen));
+}
+
+int NET_Send(int fd, void *message, int length, unsigned int flags) {
+  return plant_socket_result(send(fd, message, (uint32_t)length, flags));
+}
+
+int NET_SendTo(int fd, const void *message, int length, unsigned int flags,
+               const struct sockaddr *to, int tolen) {
+  return plant_socket_result(sendto(fd, message, (uint32_t)length, flags, to,
+                                    (socklen_t)tolen));
+}
+
+int NET_Connect(int fd, struct sockaddr *address, int address_length) {
+  return plant_socket_result(
+      connect(fd, address, (socklen_t)address_length));
+}
+
+int NET_Accept(int fd, struct sockaddr *address, socklen_t *address_length) {
+  return plant_socket_result(accept(fd, address, address_length));
+}
+
+int NET_Poll(struct pollfd *fds, unsigned int nfds, int timeout) {
+  return poll(fds, (nfds_t)nfds, timeout);
+}
+
+int NET_Timeout(JNIEnv *env, int fd, long timeout, jlong nano_time_stamp) {
+  (void)env;
+  (void)nano_time_stamp;
+  struct pollfd descriptor = {fd, POLLIN | POLLERR, 0};
+  return poll(&descriptor, 1, (int)timeout);
+}
+
+#else
+
+/* The build JDK runs on Linux even when the target is Plant OS. */
+#include "../../../linux/native/libnet/linux_close.c"
+
+#endif
