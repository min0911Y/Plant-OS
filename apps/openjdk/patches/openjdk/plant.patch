+        return new UnsupportedProvider();
+    }
+
+    private static final class UnsupportedProvider extends AsynchronousChannelProvider {
+        private UnsupportedOperationException unsupported() {
+            return new UnsupportedOperationException(
+                "asynchronous channels are not supported on Plant OS");
